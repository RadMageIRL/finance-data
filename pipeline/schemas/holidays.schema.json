{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rmf.econ.holidays/1",
  "title": "A Federal Reserve holiday table (DATA_CONVENTIONS section 17.9)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source",
    "checked",
    "years",
    "holidays"
  ],
  "properties": {
    "schema": {
      "const": "rmf.econ.holidays/1"
    },
    "status": {
      "enum": [
        "verified",
        "fixture"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "checked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "years": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1990
      }
    },
    "holidays": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "note": {
      "type": "string"
    }
  }
}
