{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rmf.econ.registry/3",
  "title": "RadMage Finance source registry (DATA_CONVENTIONS section 4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "conventions",
    "family",
    "family_policy",
    "sources",
    "calendars",
    "series",
    "holiday_table"
  ],
  "properties": {
    "schema": {
      "const": "rmf.econ.registry/3"
    },
    "conventions": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+$"
    },
    "family": {
      "const": "econ"
    },
    "family_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention",
        "archive",
        "unexpected_revision",
        "interpolation",
        "namespace",
        "review"
      ],
      "properties": {
        "retention": {
          "const": "full-history"
        },
        "archive": {
          "const": "permanent"
        },
        "unexpected_revision": {
          "const": "hold"
        },
        "interpolation": {
          "const": "never"
        },
        "namespace": {
          "const": "/finance/data/econ/"
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permissions"
          ],
          "properties": {
            "permissions": {
              "type": "array",
              "items": {
                "enum": [
                  "admin",
                  "maintain",
                  "write"
                ]
              },
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "calendars": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/calendar"
        }
      }
    },
    "series": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/series"
      }
    },
    "holiday_table": {
      "const": "fed-holidays.json"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 40
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d+$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publisher",
        "host",
        "terms_url",
        "terms_checked",
        "license",
        "commercial_use",
        "attribution",
        "notice",
        "pass_through",
        "modification_label",
        "key_required",
        "request",
        "calendar"
      ],
      "properties": {
        "publisher": {
          "$ref": "#/$defs/text"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+$"
        },
        "terms_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "terms_checked": {
          "$ref": "#/$defs/date"
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "commercial_use": {
          "enum": [
            "allowed",
            "allowed-with-conditions",
            "unknown"
          ]
        },
        "attribution": {
          "$ref": "#/$defs/text"
        },
        "notice": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "pass_through": {
          "type": "boolean"
        },
        "modification_label": {
          "type": "boolean"
        },
        "key_required": {
          "const": false
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min_interval_seconds",
            "max_retries",
            "user_agent",
            "contact"
          ],
          "properties": {
            "min_interval_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "max_retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "user_agent": {
              "const": "RadMage Finance (+https://radmagelabs.com/finance/)"
            },
            "contact": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "const": "radmageirl@radmagelabs.com"
                }
              ]
            }
          }
        },
        "calendar": {
          "$ref": "#/$defs/id"
        },
        "route_notices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "route",
              "date",
              "affects_registered_route",
              "text",
              "checked",
              "milestone"
            ],
            "properties": {
              "route": {
                "$ref": "#/$defs/text"
              },
              "date": {
                "$ref": "#/$defs/date"
              },
              "affects_registered_route": {
                "type": "boolean"
              },
              "text": {
                "$ref": "#/$defs/text"
              },
              "checked": {
                "$ref": "#/$defs/date"
              },
              "milestone": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    },
    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "business_day_zone",
        "publish_time",
        "publish_time_zone",
        "grace_hours"
      ],
      "properties": {
        "kind": {
          "enum": [
            "rule",
            "calendar"
          ]
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "dataset_id": {
          "$ref": "#/$defs/text"
        },
        "ignore_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "markers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "business_day_zone": {
          "const": "America/New_York"
        },
        "publish_time": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "publish_time_zone": {
          "enum": [
            "America/New_York",
            "UTC",
            "unknown"
          ]
        },
        "grace_hours": {
          "type": "integer",
          "minimum": 0,
          "maximum": 48
        },
        "rule_valid_from": {
          "$ref": "#/$defs/date"
        },
        "calendar_valid_from": {
          "$ref": "#/$defs/date"
        },
        "publish_time_zone_candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "America/New_York",
              "UTC"
            ]
          }
        }
      }
    },
    "extract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "from",
        "to"
      ],
      "properties": {
        "schema": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/period"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/period"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "rate",
            "range"
          ]
        },
        "lower": {
          "type": "string"
        },
        "upper": {
          "type": "string"
        },
        "extra": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "null_text": {
          "type": "string"
        },
        "missing_code": {
          "type": "string"
        },
        "series_name": {
          "type": "string"
        },
        "adjusted": {
          "enum": [
            "SA",
            "NSA"
          ]
        },
        "unit": {
          "type": "string"
        },
        "unit_mult": {
          "type": "string"
        },
        "missing_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refuse_zero": {
          "type": "boolean"
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "short_title",
        "source",
        "data_name",
        "class",
        "frequency",
        "unit",
        "unit_label",
        "decimals",
        "seasonal_adjustment",
        "segment",
        "fetch",
        "extract",
        "range",
        "continuity",
        "revision",
        "staleness",
        "release",
        "earliest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "short_title": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "data_name": {
          "$ref": "#/$defs/text"
        },
        "class": {
          "enum": [
            "market_observation",
            "policy_target",
            "administrative_daily",
            "revised_aggregate"
          ]
        },
        "frequency": {
          "enum": [
            "business-day",
            "month",
            "change-point"
          ]
        },
        "unit": {
          "enum": [
            "percent",
            "usd",
            "usd-billions"
          ]
        },
        "unit_label": {
          "$ref": "#/$defs/text"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "seasonal_adjustment": {
          "enum": [
            "sa",
            "nsa",
            "none"
          ]
        },
        "segment": {
          "enum": [
            "year",
            "all"
          ]
        },
        "fetch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "format",
            "parameters"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^https://"
            },
            "format": {
              "enum": [
                "json",
                "sdmx-zip"
              ]
            },
            "parameters": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "shared_with": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "extract": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/extract"
          }
        },
        "derived_from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "series",
            "method"
          ],
          "properties": {
            "series": {
              "$ref": "#/$defs/id"
            },
            "method": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "known_inconsistencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "text"
            ],
            "properties": {
              "period": {
                "$ref": "#/$defs/period"
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "range": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "$ref": "#/$defs/decimal"
            },
            "max": {
              "$ref": "#/$defs/decimal"
            }
          }
        },
        "continuity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_gap",
            "unit"
          ],
          "properties": {
            "max_gap": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "unit": {
              "enum": [
                "days",
                "months",
                null
              ]
            }
          }
        },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window"
          ],
          "properties": {
            "window": {
              "enum": [
                "publication-day",
                "none",
                "scheduled-release"
              ]
            },
            "statistics_window_business_days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            },
            "alert_ratio": {
              "$ref": "#/$defs/decimal"
            }
          }
        },
        "staleness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "after_business_days": {
              "type": "integer",
              "minimum": 1
            },
            "after_days_past_expected_release": {
              "type": "integer",
              "minimum": 1
            },
            "follows": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "calendar"
          ],
          "properties": {
            "basis": {
              "enum": [
                "rule",
                "calendar",
                "first-seen"
              ]
            },
            "calendar": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "earliest": {
          "$ref": "#/$defs/period"
        },
        "known_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "period",
              "text"
            ],
            "properties": {
              "period": {
                "$ref": "#/$defs/period"
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      }
    }
  }
}
